{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": true,
    "resolveJsonModule": true,

    "paths": {
      "@canvas/*": ["./src/canvas/*"],
      "@constants/*": ["./src/constants/*"],
      "@fields/*": ["./src/fields/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@scene/*": ["./src/documents/scene/*"],
      "@settings/*": ["./src/settings/*"],
      "@vc/*": ["./src/vue/components/*"],
      "@vueApps/*": ["./src/vue/apps/*"],
      "@vueStores/*": ["./src/vue/stores/*"],
      "@common/*": ["./types/foundry/common/*"],
      "@client/*": ["./types/foundry/client/*"],
      "@items/*": ["./src/documents/items/*"],
      "@actors/*": ["./src/documents/actors/*"],
      "@effects/*": ["./src/documents/activeEffects/*"],
      "@documents/*": ["./src/documents/*"],
      "@source/*": ["./src/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": [],

    /* Interop */
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "./types/foundry/global-external.d.mts",
    "./types/foundry/client/global-external.d.mts",
    "./types/foundry/common/global-external.d.mts",
    "./types/shims-vue.d.mts"
  ],
  "exclude": ["node_modules"]
}
