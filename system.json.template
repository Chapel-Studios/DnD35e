{
  "id": "dnd35e",
  "title": "Dungeons & Dragons 3.5 Edition SRD",
  "description": "Implementation of 3.5 edition System Reference Document for Foundry VTT. Aiming to provide 100% SRD coverage.",
  "version": "{{VERSION}}",
  "compatibility": {
    "minimum": "14.354",
    "verified": "14.365"
  },
  "authors": [
      {
        "name": "Antoni 'Rughalt' Sobkowicz"
      },
      {
        "name": "'Rev' Jake Blackwell"
      }
  ],
  "esmodules": [
      "main.mjs"
  ],
  "styles": [
      "main.css"
  ],
  "languages": [
      {
          "lang": "en",
          "path": "lang/en.json",
          "name": "English"
      }
  ],
  "flags": {
  },
  "packs": [
    {
      "name": "materials",
      "label": "dnd35e.COMPENDIUM.PACK.Materials",
      "type": "ActiveEffect",
      "flags": {
        "dnd35e": {
          "indexFields": ["system.materialSubtype"]
        }
      }
    },
    {
      "name": "documentation",
      "label": "dnd35e.COMPENDIUM.PACK.Documentation",
      "type": "JournalEntry"
    },
    {
      "name": "weapons",
      "label": "dnd35e.COMPENDIUM.PACK.Weapons",
      "type": "Item",
      "flags": {
        "dnd35e": {
          "indexFields": ["system.weaponType", "system.weaponSubtype", "system.weaponBaseType"]
        }
      }
    },
    {
      "name": "macros-dev",
      "label": "dnd35e.COMPENDIUM.PACK.MacrosDev",
      "type": "Macro",
      "_dev": true
    }
  ],
  "packFolders": [
    {
      "name": "Content",
      "sorting": "a",
      "packs": ["materials", "weapons", "documentation"]
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {}
    },
    "Item": {
      "weapon": {},
      "container": {}
    },
    "ActiveEffect": {
      "general": {},
      "material": {},
      "secret": {},
      "containment": {}
    }
  }
}
