# Force binary handling for the Foundry test-world LevelDB snapshot.
# LevelDB files include text-looking sentinels (CURRENT, LOG, MANIFEST-*) and
# binary tables (*.ldb, *.log). All of them must be byte-exact or Foundry
# will refuse to open the world. Disable CRLF conversion across the snapshot.
tests/e2e/fixtures/test-world/dnd35e-e2e/data/** binary

# Pack source JSON files are generated by `npm run unpack` with LF line endings.
# Force LF here so re-packing never shows spurious CRLF diffs on Windows.
packs/_source/**/*.json text eol=lf
