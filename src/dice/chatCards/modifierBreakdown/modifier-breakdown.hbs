{{!--
  Modifier breakdown partial — spliced into Foundry's own `.dice-roll .dice-tooltip .wrapper`
  (see `buildSaveCard()` in rollMessages.mts) so it shows/hides with the same click-to-expand
  toggle as the die faces, no separate reveal control of our own.
--}}
<ul class="modifier-breakdown">
  {{#each modifiers}}
  <li class="modifier-row{{#if this.isIgnored}} is-ignored{{/if}}">
    <div class="modifier-row-main">
      <span class="modifier-label">
        {{this.label}}
        {{#if this.bonusTypeLabel}}<span class="modifier-bonus-type">[{{this.bonusTypeLabel}}]</span>{{/if}}
      </span>
      <span class="modifier-value">{{this.signed}}</span>
    </div>
    {{#if this.isIgnored}}<div class="modifier-ignored-reason">{{this.ignoredReason}}</div>{{/if}}
  </li>
  {{/each}}
</ul>
